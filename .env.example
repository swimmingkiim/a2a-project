# A2A Agent Node Environment Variables Example
# Copy this file to .env and fill in your actual values
# ⚠️ Never commit .env file to git!

# Port configuration
PORT=8080

# Treasury wallet address for revenue (optional)
# TREASURY_ADDRESS=0x...

# DID Private Key (Base64 encoded)
# PRIVATE_KEY=...

# External API keys (if needed)
# AIRLINE_API_KEY=...

# Database (if needed)
# DATABASE_URL=postgresql://...

# Pimlico Paymaster (ERC-4337)
# This is now PROXIED by the Paymaster service.
# PIMLICO_API_KEY=...

# Network configuration
# NETWORK=base-sepolia  # or base-mainnet

# Secret key (32-byte hex string, etc) - Required!
AGENT_SECRET_KEY=29739248cad1bd5a625441a0d8ba398e
