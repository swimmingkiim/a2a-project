# Base Mainnet Deployment Configuration
# 
# ⚠️  SECURITY WARNING:
# - Never commit this file to git
# - Use strong, unique private keys
# - Keep backup of all keys securely

# ============================================================
# Network Configuration
# ============================================================

# Base Mainnet RPC (Choose one)
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Or use Alchemy/Infura:
# BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Basescan API Key (for contract verification)
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ============================================================
# Deployer Configuration
# ============================================================

# Deployer Private Key (needs ETH for deployment gas)
# ⚠️  WARNING: This wallet will have admin rights on COMP token
DEPLOYER_PRIVATE_KEY=0x...

# Estimated gas needed: ~0.01 ETH
# Get ETH: https://www.coinbase.com/ or your preferred exchange

# ============================================================
# COMP Token Configuration
# ============================================================

# Initial supply to mint (18 decimals)
# Example: 1000000 = 1,000,000 COMP
INITIAL_SUPPLY=1000000

# Paymaster address (will receive MINTER_ROLE)
# ⚠️  IMPORTANT: Set this to your production paymaster address
PAYMASTER_ADDRESS=0x...

# ============================================================
# Paymaster Service Configuration
# ============================================================

# Treasury address (receives fees)
TREASURY_ADDRESS=0x...

# Fee configuration
FEE_AMOUNT=100000  # 0.1 USDC (6 decimals)
MARKUP_RATE=0.1    # 10% markup

# Token addresses (Base Mainnet)
FEE_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  # USDC
# COMP_TOKEN_ADDRESS will be set after deployment

# Oracle configuration
ETH_PRICE_USD=2500  # Update with current price
COMP_PRICE_USD=0.10  # Initial COMP price in USD

# COMP features (start disabled, enable gradually)
ENABLE_COMP_FEES=false

# ============================================================
# Deployment Checklist
# ============================================================

# Before deploying, ensure:
# [ ] Deployer wallet funded with >0.01 ETH
# [ ] PAYMASTER_ADDRESS is correct production address
# [ ] TREASURY_ADDRESS is secure multi-sig or hardware wallet
# [ ] BASESCAN_API_KEY is valid
# [ ] All addresses are Base Mainnet addresses (not Sepolia!)
# [ ] Backup of all private keys stored securely
# [ ] Team notified of pending deployment

# ============================================================
# Post-Deployment Steps
# ============================================================

# 1. Save deployed COMP_TOKEN_ADDRESS
# 2. Verify contract on Basescan
# 3. Update paymaster .env with COMP_TOKEN_ADDRESS
# 4. Test with small amounts first
# 5. Gradually enable COMP_FEES
