# ========================================
# Paymaster Production Environment Template
# ========================================
# Copy this to `.env` and fill in your actual values
# CRITICAL: Never commit .env file to git!

# ========================================
# ENVIRONMENT
# ========================================
NODE_ENV=production
# CRITICAL: CI must be unset or false in production
# If CI=true, balance verification will be skipped!
# CI=

# ========================================
# NETWORK & RPC
# ========================================
# Base Mainnet RPC URL (e.g., Alchemy, Infura, QuickNode)
RPC_URL=https://mainnet.base.org
# Alternative: https://base-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# Upstream Paymaster URL (Pimlico)
UPSTREAM_PAYMASTER_URL=https://api.pimlico.io/v2/base/rpc?apikey=YOUR-PIMLICO-API-KEY

# Pimlico Sponsorship Policy ID (optional but recommended)
PIMLICO_POLICY_ID=

# ========================================
# TOKEN ADDRESSES (Base Mainnet)
# ========================================
# USDC on Base Mainnet (official)
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Your deployed $COMP token address
COMP_TOKEN_ADDRESS=0x...

# Treasury address to receive fees
TREASURY_ADDRESS=0x...

# ========================================
# FEE CONFIGURATION
# ========================================
# Floor fee in USDC (6 decimals)
# Example: 100000 = 0.1 USDC minimum
FEE_AMOUNT=100000

# ETH price in USD for dynamic fee calculation
# Update periodically or use oracle
ETH_PRICE_USD=2500

# Markup rate (decimal)
# Recommended: 1.5 (150%) for gas volatility buffer
# This protects against sudden gas spikes
MARKUP_RATE=1.5

# ========================================
# PAYMASTER SIGNER (Gas Funding Wallet)
# ========================================
# Private key of wallet that pays gas fees
# SECURITY: Store in secure secret manager in production!
# This wallet MUST have sufficient ETH balance
PAYMASTER_SIGNER_PRIVATE_KEY=0x...

# Minimum ETH balance threshold for alerts (in ETH)
# Alert when funding wallet drops below this amount
MIN_SIGNER_BALANCE_ETH=0.01

# ========================================
# AUTHENTICATION
# ========================================
# Static API key for admin access
A2A_PAYMASTER_API_KEY=your-secure-random-api-key-here

# ========================================
# DATABASE (Optional - for dynamic API keys)
# ========================================
# Leave empty to disable database features
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ========================================
# SECURITY & LIMITS
# ========================================
# Server port
PORT=8080

# Rate limiting (requests per minute per API key)
RATE_LIMIT_RPM=60

# ========================================
# EMERGENCY CONTROLS
# ========================================
# Emergency shutdown flag
# Set to 'true' to immediately stop accepting new requests
# Use this if you detect anomalous behavior or fund drainage
DISABLE_PAYMASTER=false

# ========================================
# MONITORING & LOGGING
# ========================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ========================================
# PRODUCTION CHECKLIST
# ========================================
# Before deploying, verify:
# [ ] CI is unset or false
# [ ] All token addresses are correct for Base Mainnet
# [ ] PAYMASTER_SIGNER_PRIVATE_KEY wallet has >= 0.01 ETH
# [ ] TREASURY_ADDRESS is set to your treasury wallet
# [ ] MARKUP_RATE is >= 1.5 for safety buffer
# [ ] DISABLE_PAYMASTER is false
# [ ] NODE_ENV is production
# [ ] RPC_URL points to reliable provider
# [ ] UPSTREAM_PAYMASTER_URL is configured
