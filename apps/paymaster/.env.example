# --- NETWORK CONFIGURATION (Choose One) ---

# [Option 1] Base Mainnet (Production)
# UPSTREAM_PAYMASTER_URL=https://api.pimlico.io/v2/8453/rpc?apikey=YOUR_API_KEY
# RPC_URL=https://mainnet.base.org

# [Option 2] Base Sepolia (Testnet)
# UPSTREAM_PAYMASTER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=YOUR_API_KEY
# RPC_URL=https://sepolia.base.org

# Default fallbacks (if commented out) may vary, explicit config recommended.

# Server Configuration
PORT=8080


# API Key for clients to authenticate with this Paymaster
# Generate a random string (e.g., openssl rand -hex 32)
A2A_PAYMASTER_API_KEY=your-secret-api-key-here


# Treasury Address for fee collection (Must be set!)
TREASURY_ADDRESS=0xYourTreasuryAddressHere

# (Optional) For future gas estimation/validation
# RPC_URL=https://sepolia.base.org
