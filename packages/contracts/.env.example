# ============================================================
# 1. Network Configuration
# ============================================================
# Deployer wallet private key (WITHOUT 0x prefix)
# This wallet must have some ETH for gas (~0.015 ETH recommended).
# It will automatically RENOUNCE ownership after deployment.
DEPLOYER_PRIVATE_KEY=your_temporary_private_key_here

# Base Mainnet RPC URL (Infura, Alchemy, etc.)
# If left default, it might be rate-limited.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Base Sepolia RPC URL (Optional, for testnet deployment)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ============================================================
# 2. Verification (Optional but Recommended)
# ============================================================
# Basescan API key for contract verification
# Get one at https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# ============================================================
# 3. Genesis Security (Critical)
# ============================================================
# Leave EMPTY to auto-generate a Secure Admin Wallet (Recommended).
# If set, all admin rights will be transferred to this address instead.
FINAL_ADMIN_ADDRESS=

# ============================================================
# 4. Optional Configurations
# ============================================================
# Gas reporter (true/false)
REPORT_GAS=false
