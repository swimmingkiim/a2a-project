# Environment variables for DaimToken deployment

# ============================================================
# Token Configuration
# ============================================================
TOKEN_NAME="Daim Token"
TOKEN_SYMBOL="DAIM"
# Initial supply to mint (18 decimals)
# Example: 1000000 = 1,000,000 Tokens
INITIAL_SUPPLY=1000000

# Deployer wallet private key (WITHOUT 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Paymaster Gateway address (will receive MINTER_ROLE)
PAYMASTER_ADDRESS=0x...

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Basescan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# Gas reporter (optional)
REPORT_GAS=false
